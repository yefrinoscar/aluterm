# Dominio público (sin slash final). Usado en canonical, Open Graph y Mercado Pago.
PUBLIC_SITE_URL=https://mantatermica.pe

# WhatsApp en formato internacional, sin +
PUBLIC_WHATSAPP=51999999999

# Yape (pago directo). Sube tu QR real a /public/images/yape-qr.png
PUBLIC_YAPE_PHONE=999999999
PUBLIC_YAPE_NAME=AluTerm

# Mercado Pago — Checkout Pro (https://www.mercadopago.com.pe/developers)
PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Envío en soles
PUBLIC_SHIPPING_LIMA=10
PUBLIC_SHIPPING_PROVINCIA=15

# Publicidad — deja vacío para no inyectar el pixel
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
PUBLIC_TIKTOK_PIXEL_ID=

# Opcional: webhook propio para recibir pedidos (Slack, Make, n8n)
ORDER_NOTIFY_WEBHOOK=
