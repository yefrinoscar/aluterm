---
import { steps } from "../data/product";
---

<section class="section" id="como-usar">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Cómo se usa</p>
      <h2>Tres movimientos. Dos minutos.</h2>
    </div>
    <div class="steps-grid steps-3">
      {steps.map((step) => (
        <article class="card step">
          <div class="n">{step.n}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
