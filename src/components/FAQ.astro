---
import { faqs } from "../data/product";
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Preguntas</p>
      <h2>Antes de comprar</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
