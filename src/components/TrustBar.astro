---
import { product } from "../data/product";
---

<section class="trust" aria-label="Datos clave">
  <div class="wrap trust-grid">
    <div class="trust-item">
      <span>{product.heatRetention}%</span>
      <p>del calor corporal se queda contigo</p>
    </div>
    <div class="trust-item">
      <span>{product.heightCm}×{product.widthCm}</span>
      <p>centímetros. Cubre a un adulto</p>
    </div>
    <div class="trust-item">
      <span>{product.weightG} g</span>
      <p>cabe en la guantera o la mochila</p>
    </div>
    <div class="trust-item">
      <span>5 = 0</span>
      <p>unidades y el envío sale gratis</p>
    </div>
  </div>
</section>
