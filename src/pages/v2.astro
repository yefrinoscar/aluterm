---
export const prerender = true;

import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PaymentTrust from "../components/PaymentTrust.astro";
import { brand, faqs, packs, shipping, siteUrl } from "../data/product";
import { soles } from "../lib/money";
import heroImage from "../assets/images/aluterm-trekking-hero.png";
import compactImage from "../assets/images/aluterm-trekking-compact.png";
import packsImage from "../assets/images/aluterm-trekking-pack5.png";
import campImage from "../assets/images/aluterm-trekking-camp.png";
import restImage from "../assets/images/aluterm-trekking-rest.png";
import unfoldedImage from "../assets/images/aluterm-trekking-unfolded.png";
import backpackImage from "../assets/images/aluterm-trekking-backpack.png";

const wa = import.meta.env.PUBLIC_WHATSAPP || "51999999999";
const featuredPack = packs.find((pack) => pack.highlight) ?? packs[packs.length - 1];
const packSubtitles: Record<string, string> = {
  unit: "Para una mochila",
  pack3: "Para salir en pareja o equipo",
  pack5: "Para todo el grupo",
};
const visibleFaqs = faqs
  .filter((faq) => !/sismo/i.test(faq.q))
  .map((faq) =>
    /reutilizar/i.test(faq.q)
      ? { ...faq, a: "Sí, si no se rompe. Dóblala con cuidado y vuelve a guardarla seca en su sobre. Después de un uso exigente, conviene reemplazarla." }
      : faq,
  )
  .slice(0, 7);
---

<BaseLayout
  title="AluTerm — Protección térmica ultraligera para trekking"
  description="Una capa térmica de solo 52 g para trekking y campamento. Compacta, impermeable y cortaviento."
  canonical={`${siteUrl}/v2`}
  keywords="manta térmica trekking, manta aluminizada trekking, equipo trekking, manta térmica camping, manta 140x210"
  ogImageAlt="Trekker usando una manta térmica plateada en los Andes"
  type="product"
  noindex={true}
  includeJsonLd={false}
>
  <div class="v2-page">
    <div class="v2-announce">
      <p><span aria-hidden="true"></span> Despachos a todo el Perú · Envío gratis en pack de 5</p>
    </div>

    <header class="v2-header">
      <div class="v2-shell v2-header__inner">
        <a class="v2-logo" href="/v2" aria-label={`${brand.name}, inicio`}>
          <svg viewBox="0 0 36 36" aria-hidden="true">
            <path d="M5 27 18 5l13 22H5Z" fill="currentColor"></path>
            <path d="m12 24 6-10 6 10H12Z" fill="#f2f4f5"></path>
          </svg>
          <span>{brand.name}<small>Equipo para trekking</small></span>
        </a>
        <nav class="v2-nav" aria-label="Navegación principal">
          <a href="#por-que">Por qué llevarla</a>
          <a href="#usos">En la montaña</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a class="v2-button v2-button--small" href="#comprar-ahora">Comprar ahora</a>
      </div>
    </header>

    <main id="contenido">
      <section class="v2-sale-hero" id="comprar-ahora" aria-labelledby="v2-title">
        <div class="v2-shell v2-sale-hero__grid">
          <div class="v2-sale-media">
            <div class="v2-sale-media__main">
              <Image
                src={heroImage}
                alt="Trekker protegido con una manta térmica plateada en un paso de montaña"
                widths={[640, 900, 1200]}
                sizes="(max-width: 800px) 100vw, 52vw"
                quality={88}
                loading="eager"
              />
              <div class="v2-sale-badge">
                <strong>90%</strong>
                <span>del calor<br />corporal reflejado</span>
              </div>
              <span class="v2-sale-stock"><i aria-hidden="true"></i> En stock · despacho desde Lima</span>
            </div>
            <div class="v2-sale-media__thumbs" aria-label="Detalles del producto">
              <figure>
                <Image src={compactImage} alt="Manta térmica AluTerm plegada en una mano" width={280} quality={80} />
                <figcaption>Cabe en la palma</figcaption>
              </figure>
              <figure>
                <Image src={packsImage} alt="Packs de mantas térmicas AluTerm" width={280} quality={80} />
                <figcaption>Disponible en packs</figcaption>
              </figure>
              <div class="v2-sale-spec">
                <span>Medida abierta</span>
                <strong>140 × 210 cm</strong>
                <small>52 g aprox.</small>
              </div>
            </div>
          </div>

          <div class="v2-sale-buy">
            <h1 id="v2-title">No pierdas calor cuando cambie el clima.</h1>
            <p class="v2-sale-buy__lead">
              Una capa de respaldo de solo 52 gramos para trekking y campamento. Refleja hasta el
              90% del calor corporal, corta el viento y cabe en cualquier mochila.
            </p>

            <ul class="v2-sale-checks" aria-label="Beneficios principales">
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>Solo 52 g</li>
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>140 × 210 cm abierta</li>
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>Impermeable y cortaviento</li>
            </ul>

            <div class="v2-sale-price" aria-live="polite">
              <span>Precio del pack</span>
              <div><strong data-v2-total>{soles(featuredPack.price)}</strong><small data-v2-summary>{soles(featuredPack.unitPrice)} c/u · envío gratis</small></div>
            </div>

            <div class="v2-sale-options" role="radiogroup" aria-labelledby="sale-pack-label">
              <p id="sale-pack-label">Elige cuántas llevas</p>
              <div>
                {packs.map((pack) => (
                  <button
                    type="button"
                    class:list={["v2-sale-option", pack.id === featuredPack.id && "is-selected"]}
                    role="radio"
                    aria-checked={pack.id === featuredPack.id ? "true" : "false"}
                    data-v2-pack={pack.id}
                    data-price={pack.price}
                    data-unit={pack.unitPrice}
                    data-free={pack.freeShipping ? "true" : "false"}
                  >
                    {pack.badge && <em>{pack.badge}</em>}
                    <strong>{pack.title}</strong>
                    <span>{soles(pack.price)}</span>
                    <small>{soles(pack.unitPrice)} c/u</small>
                  </button>
                ))}
              </div>
            </div>

            <a class="v2-button v2-sale-buy__cta" href={`/checkout?pack=${featuredPack.id}`} data-v2-checkout>
              Comprar ahora · <span data-v2-total>{soles(featuredPack.price)}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
            </a>
            <p class="v2-sale-shipping">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h9v9H3V5Zm9 3h3l2 3v3h-5V8ZM6 16a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /></svg>
              Lima 24–48 h · provincias 2–5 días · envío gratis en pack x5
            </p>
            <PaymentTrust variant="trekking" />
          </div>
        </div>
      </section>

      <section class="v2-situation" aria-label="Situaciones de uso">
        <div class="v2-shell v2-situation__inner">
          <p>Pensada para salir ligero</p>
          <ul>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16M6 16l6-12 6 12M9 16l3-6 3 6" /></svg>Altura</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M5 8l7-5 7 5M4 16l8-6 8 6" /></svg>Campamento</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 20 7-12 4 7 2-3 5 8H3Z" /></svg>Trekking</li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 16c2-1 3-4 4-8 1 4 2 7 4 8m-9 3h16M16 5v8m-2-2 2 2 2-2" /></svg>Mochila ligera</li>
          </ul>
        </div>
      </section>

      <section class="v2-why" id="por-que" aria-labelledby="why-title">
        <div class="v2-shell">
          <div class="v2-section-head v2-section-head--split">
            <p class="v2-kicker">52 gramos de respaldo</p>
            <h2 id="why-title">El equipo térmico que sí entra en tu mochila.</h2>
            <p>
              En una pausa larga, un cambio de clima o una noche más fría de lo previsto, crea una
              barrera contra la pérdida de calor, el viento y la lluvia.
            </p>
          </div>

          <div class="v2-scale">
            <div class="v2-scale__image">
              <Image
                src={unfoldedImage}
                alt="Manta térmica plateada desplegada dentro de una carpa de trekking"
                widths={[520, 760, 1024]}
                sizes="(max-width: 800px) 100vw, 58vw"
                quality={86}
              />
              <span class="v2-measure v2-measure--top">140 × 210 cm abierta</span>
              <span class="v2-measure v2-measure--side">Impermeable y cortaviento</span>
            </div>
            <div class="v2-scale__facts">
              <article>
                <span>01 / Conserva</span>
                <strong>Hasta 90%</strong>
                <p>Refleja el calor del cuerpo para reducir la pérdida de temperatura.</p>
              </article>
              <article>
                <span>02 / Despliega</span>
                <strong>140 × 210 cm</strong>
                <p>Cubre a un adulto completo y también funciona como toldo o suelo aislante.</p>
              </article>
              <article>
                <span>03 / Transporta</span>
                <strong>52 gramos</strong>
                <p>Menos que una manzana. Va en la tapa, el bolsillo lateral o el botiquín de la mochila.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="v2-uses" id="usos" aria-labelledby="uses-title">
        <div class="v2-shell">
          <div class="v2-section-head">
            <p class="v2-kicker">En terreno</p>
            <h2 id="uses-title">Hecha para acompañar tu ruta.</h2>
          </div>
          <div class="v2-use-grid">
            <article class="v2-use-card v2-use-card--wide">
              <Image src={campImage} alt="Trekker protegido con una manta térmica junto a su carpa en la montaña" widths={[600, 900, 1152]} sizes="(max-width: 800px) 100vw, 50vw" quality={82} />
              <div><span>Al caer la tarde</span><h3>En el campamento</h3><p>Una barrera ligera frente al viento y el frío mientras montas, cocinas o esperas.</p></div>
            </article>
            <article class="v2-use-card">
              <Image src={restImage} alt="Trekker descansando protegido del viento con una manta térmica en altura" widths={[480, 720, 1000]} sizes="(max-width: 800px) 100vw, 25vw" quality={82} />
              <div><span>En una pausa</span><h3>En altura</h3><p>Reduce la pérdida de calor cuando paras y el cuerpo deja de producir tanto calor.</p></div>
            </article>
            <article class="v2-use-card">
              <Image src={backpackImage} alt="Manta térmica compacta guardada en el bolsillo exterior de una mochila de trekking" widths={[480, 720, 900]} sizes="(max-width: 800px) 100vw, 25vw" quality={82} />
              <div><span>Durante la ruta</span><h3>Siempre a mano</h3><p>Ocupa poco espacio y queda accesible sin desarmar toda la mochila.</p></div>
            </article>
          </div>
        </div>
      </section>

      <section class="v2-packs" id="packs" aria-labelledby="packs-title">
        <div class="v2-shell v2-packs__grid">
          <div class="v2-packs__intro">
            <p class="v2-kicker">Elige tu pack</p>
            <h2 id="packs-title">Una para cada mochila del grupo.</h2>
            <p>Selecciona un pack. En la siguiente pantalla eliges Yape, Mercado Pago o contraentrega.</p>
            <ul>
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>Despacho a todo el Perú</li>
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>Pago seguro o al recibir</li>
              <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-9" /></svg>Envío gratis desde 5 unidades</li>
            </ul>
          </div>

          <div class="v2-pack-picker" role="radiogroup" aria-label="Cantidad de mantas">
            {packs.map((pack) => (
              <button
                type="button"
                class:list={["v2-pack", pack.id === featuredPack.id && "is-selected"]}
                role="radio"
                aria-checked={pack.id === featuredPack.id ? "true" : "false"}
                data-v2-pack={pack.id}
                data-price={pack.price}
                data-unit={pack.unitPrice}
                data-free={pack.freeShipping ? "true" : "false"}
              >
                <span class="v2-pack__radio" aria-hidden="true"></span>
                <span class="v2-pack__name">
                  <strong>{pack.title}</strong>
                  <small>{packSubtitles[pack.id]}</small>
                </span>
                {pack.badge && <em>{pack.badge}</em>}
                <span class="v2-pack__price">
                  <strong>{soles(pack.price)}</strong>
                  <small>{soles(pack.unitPrice)} c/u</small>
                </span>
              </button>
            ))}
            <div class="v2-pack-summary" aria-live="polite">
              <div>
                <span>Total</span>
                <strong data-v2-total>{soles(featuredPack.price)}</strong>
                <small data-v2-summary>{soles(featuredPack.unitPrice)} c/u · envío gratis</small>
              </div>
              <a class="v2-button" href={`/checkout?pack=${featuredPack.id}`} data-v2-checkout>
                Continuar al pago
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
              </a>
            </div>
            <p class="v2-pack-note">Envío: Lima S/ {shipping.lima} · provincias S/ {shipping.provincia} · gratis en pack de 5.</p>
          </div>
        </div>
      </section>

      <section class="v2-how" aria-labelledby="how-title">
        <div class="v2-shell">
          <div class="v2-section-head v2-section-head--split">
            <p class="v2-kicker">Uso directo, sin piezas</p>
            <h2 id="how-title">Despliega. Envuelve. Protege.</h2>
            <p>En frío, coloca la cara plateada hacia el cuerpo y reduce las entradas de aire.</p>
          </div>
          <ol class="v2-steps">
            <li><span>1</span><div><strong>Ábrela por completo</strong><p>Despliega con cuidado para no perforar la película.</p></div></li>
            <li><span>2</span><div><strong>Envuelve el cuerpo</strong><p>Cubre torso, piernas y cabeza dejando libre el rostro.</p></div></li>
            <li><span>3</span><div><strong>Sella el viento</strong><p>Ajusta los bordes para conservar el aire tibio alrededor.</p></div></li>
          </ol>
          <p class="v2-how__note"><strong>Importante:</strong> refleja tu calor, no lo genera. No reemplaza atención médica ni equipo técnico de alta montaña.</p>
        </div>
      </section>

      <section class="v2-faq" id="preguntas" aria-labelledby="faq-title">
        <div class="v2-shell v2-faq__grid">
          <div class="v2-faq__intro">
            <p class="v2-kicker">Antes de guardarla</p>
            <h2 id="faq-title">Preguntas concretas. Respuestas claras.</h2>
            <p>¿Te quedó alguna duda?</p>
            <a href={`https://wa.me/${wa}`} rel="noopener">Escríbenos por WhatsApp <span aria-hidden="true">→</span></a>
          </div>
          <div class="v2-faq__list">
            {visibleFaqs.map((faq, index) => (
              <details open={index === 0}>
                <summary>{faq.q}<span aria-hidden="true"></span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="v2-final" aria-labelledby="final-title">
        <div class="v2-shell v2-final__inner">
          <div>
            <p class="v2-kicker">Trekking sin peso de más</p>
            <h2 id="final-title">Llévala. Ojalá no tengas que usarla.</h2>
          </div>
          <a class="v2-button v2-button--light" href="#packs">Elegir mi pack</a>
        </div>
      </section>
    </main>

    <footer class="v2-footer">
      <div class="v2-shell v2-footer__top">
        <a class="v2-logo v2-logo--footer" href="/v2" aria-label={`${brand.name}, inicio`}>
          <svg viewBox="0 0 36 36" aria-hidden="true"><path d="M5 27 18 5l13 22H5Z" fill="currentColor"></path><path d="m12 24 6-10 6 10H12Z" fill="#15191c"></path></svg>
          <span>{brand.name}<small>Protección térmica compacta</small></span>
        </a>
        <div><strong>Compra</strong><a href="#packs">Elegir pack</a><a href="/checkout">Checkout</a></div>
        <div><strong>Ayuda</strong><a href="/envios">Envíos</a><a href={`https://wa.me/${wa}`} rel="noopener">WhatsApp</a></div>
        <div><strong>Legal</strong><a href="/terminos">Términos</a><a href="/politicas">Privacidad</a></div>
      </div>
      <div class="v2-shell v2-footer__bottom">
        <span>© {new Date().getFullYear()} {brand.legalName}</span><span>Lima, Perú · Despachos nacionales</span>
      </div>
    </footer>

    <div class="v2-mobile-cta" aria-label="Acceso rápido a compra">
      <div><span data-v2-mobile-label>Pack x5 · envío gratis</span><strong data-v2-total>{soles(featuredPack.price)}</strong></div>
      <a href={`/checkout?pack=${featuredPack.id}`} data-v2-checkout>Comprar</a>
    </div>
  </div>

  <script>
    const packButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-v2-pack]")];

    function formatMoney(value: number) {
      return new Intl.NumberFormat("es-PE", {
        style: "currency",
        currency: "PEN",
        maximumFractionDigits: 0,
      }).format(value);
    }

    function selectPack(button: HTMLButtonElement) {
      const id = button.dataset.v2Pack || "pack5";
      const price = Number(button.dataset.price || 0);
      const unit = Number(button.dataset.unit || 0);
      const free = button.dataset.free === "true";
      const name = button.querySelector("strong")?.textContent?.trim() || "Pack";

      packButtons.forEach((item) => {
        const selected = item.dataset.v2Pack === id;
        item.classList.toggle("is-selected", selected);
        item.setAttribute("aria-checked", String(selected));
      });
      document.querySelectorAll<HTMLElement>("[data-v2-total]").forEach((item) => {
        item.textContent = formatMoney(price);
      });
      document.querySelectorAll<HTMLAnchorElement>("[data-v2-checkout]").forEach((link) => {
        link.href = `/checkout?pack=${id}`;
      });
      document.querySelectorAll<HTMLElement>("[data-v2-summary]").forEach((summary) => {
        summary.textContent = `${formatMoney(unit)} c/u · ${free ? "envío gratis" : "envío al pagar"}`;
      });
      const mobileLabel = document.querySelector<HTMLElement>("[data-v2-mobile-label]");
      if (mobileLabel) mobileLabel.textContent = `${name} · ${free ? "envío gratis" : "envío al pagar"}`;
      sessionStorage.setItem("alu_pack", id);
    }

    packButtons.forEach((button) => button.addEventListener("click", () => selectPack(button)));
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #f2f4f5;
  }

  .v2-page {
    --v2-ink: #15191c;
    --v2-ink-soft: #4c545a;
    --v2-paper: #f2f4f5;
    --v2-white: #fbfcfc;
    --v2-silver: #dce1e4;
    --v2-line: #c7cdd1;
    --v2-red: #c92a22;
    --v2-red-dark: #a51f19;
    --v2-dark: #15191c;
    --v2-lime: #dce7b2;
    --v2-shell: min(1240px, calc(100% - 40px));
    min-height: 100vh;
    overflow: clip;
    background: var(--v2-paper);
    color: var(--v2-ink);
    font-family: "Manrope", system-ui, sans-serif;
  }

  .v2-shell {
    width: var(--v2-shell);
    margin-inline: auto;
  }

  .v2-page a,
  .v2-page button,
  .v2-page summary {
    touch-action: manipulation;
  }

  .v2-announce {
    display: grid;
    place-items: center;
    min-height: 34px;
    padding: 6px 20px;
    background: var(--v2-dark);
    color: #fff;
    font: 700 0.7rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .v2-announce p {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .v2-announce span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--v2-lime);
    box-shadow: 0 0 0 4px rgb(220 231 178 / 12%);
  }

  .v2-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgb(21 25 28 / 11%);
    background: rgb(242 244 245 / 90%);
    backdrop-filter: blur(18px) saturate(1.2);
  }

  .v2-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 78px;
  }

  .v2-logo {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 10px;
    color: var(--v2-ink);
    font-family: "Outfit", system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-decoration: none;
  }

  .v2-logo svg {
    width: 31px;
    height: 31px;
    flex: 0 0 auto;
  }

  .v2-logo span {
    display: grid;
    gap: 4px;
  }

  .v2-logo small {
    font: 650 0.52rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .v2-nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .v2-nav a {
    position: relative;
    color: var(--v2-ink-soft);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .v2-nav a::after {
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 2px;
    background: var(--v2-red);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .v2-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .v2-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
