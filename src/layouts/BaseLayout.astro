---
import "../styles/global.css";
import AdsPixels from "../components/AdsPixels.astro";
import JsonLd from "../components/JsonLd.astro";
import { brand, seo, siteUrl } from "../data/product";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "product";
}

const {
  title = seo.title,
  description = seo.description,
  canonical = siteUrl,
  ogImage = `${siteUrl}/og.jpg`,
  noindex = false,
  type = "website",
} = Astro.props;

const wa = import.meta.env.PUBLIC_WHATSAPP || "51999999999";
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content={brand.legalName} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex" : "index, follow"} />
    <meta name="theme-color" content="#12161b" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="PE" />
    <meta name="geo.placename" content="Lima" />
    <meta name="language" content="Spanish" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-PE" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={type === "product" ? "product" : "website"} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={brand.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1376" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:alt" content="Manta térmica de emergencia Mylar AluTerm en los Andes" />
    <meta property="product:price:amount" content="15" />
    <meta property="product:price:currency" content="PEN" />
    <meta property="product:availability" content="in stock" />
    <meta property="product:condition" content="new" />
    <meta property="product:brand" content={brand.name} />
    <meta property="product:retailer_item_id" content="AT-140-210" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@450;550;650;750;800&family=Outfit:wght@500;650;750;800&display=swap"
      rel="stylesheet"
    />

    <JsonLd />
    <AdsPixels />
  </head>
  <body data-wa={wa}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      (function persistUtm() {
        const keys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "fbclid", "ttclid"];
        const params = new URLSearchParams(location.search);
        const stored = JSON.parse(localStorage.getItem("alu_attr") || "{}");
        let changed = false;
        keys.forEach((key) => {
          const value = params.get(key);
          if (value) {
            stored[key] = value;
            changed = true;
          }
        });
        if (changed) localStorage.setItem("alu_attr", JSON.stringify(stored));
      })();
    </script>
  </body>
</html>
